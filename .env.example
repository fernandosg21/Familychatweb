# Supabase — obtenha em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Web Push (VAPID) — gere com `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-vapid-public-key
VAPID_PRIVATE_KEY=sua-vapid-private-key

# Usadas apenas nas Supabase Edge Functions (não no Next.js):
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo Supabase.
# VAPID_PRIVATE_KEY, VAPID_PUBLIC_KEY, VAPID_SUBJECT devem ser configuradas via:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:voce@exemplo.com
